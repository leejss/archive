---
import Root from "@/layout/root.astro";
import { getPublishedNotes } from "@/lib/content";
import { formatDate } from "@/utils/common";

const notes = await getPublishedNotes();
---

<Root title="">
  <main class="container">
    <ul class="post-list" aria-label="Notes">
      {notes.map((post) => (
        <li class="post-item">
          <a href={`/notes/${post.id}`} class="post-link">
            {post.data.title}
          </a>
          <time datetime={post.data.publishedAt.toISOString()} class="post-date">
            {formatDate(post.data.publishedAt)}
          </time>
        </li>
      ))}
    </ul>
  </main>
</Root>

<style>
  .post-item {
    font-size: 1rem;
  }

  .post-date {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--default-muted-color);
    font-family: var(--font-mono);
    text-align: right;
    white-space: nowrap;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.7rem;
  }

  .post-item {
    align-items: baseline;
    column-gap: 0.8rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
  }

  .post-link {
    color: var(--default-link-color);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .post-link:focus-visible {
    outline: 1px solid var(--default-border-hover-color);
    outline-offset: 0.2rem;
  }

</style>
