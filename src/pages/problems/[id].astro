---
import { render } from "astro:content";
import PostLayout from "@/layout/post.astro";
import { getPublishedProblems } from "@/lib/content";

export async function getStaticPaths() {
  const problems = await getPublishedProblems();
  return problems.map((problem) => ({
    params: { id: problem.id },
    props: { problem },
  }));
}

const { problem } = Astro.props;
const { Content, headings } = await render(problem);
const {
  title,
  description,
  publishedAt,
  source,
  url,
  tags,
  aiGenerated,
} = problem.data;
---

<PostLayout
  title={title}
  description={description}
  publishedAt={publishedAt}
  tags={tags}
  aiGenerated={aiGenerated}
  headings={headings}
>
  <a slot="meta" href={url} target="_blank" rel="noopener noreferrer">{source}</a>
  <Content />
</PostLayout>
