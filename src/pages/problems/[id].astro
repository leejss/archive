---
import { getCollection, render } from "astro:content";
import Root from "@/layout/root.astro";

export async function getStaticPaths() {
  const problems = await getCollection("problem");
  return problems.map((problem) => ({
    params: { id: problem.id },
    props: { problem },
  }));
}

const { problem } = Astro.props;
const { Content } = await render(problem);
const { title, publishedAt, source, url } = problem.data;
const tags = problem.data.tags ?? [];

function dateCode(date: Date) {
  const yyyy = date.getFullYear();
  const mm = String(date.getMonth() + 1).padStart(2, "0");
  const dd = String(date.getDate()).padStart(2, "0");
  return `${yyyy}${mm}${dd}`;
}
---

<Root title={title}>
  <article class="container">
    <header class="problem-header">
      <h1 class="title">{title}</h1>
      <div class="meta">
        {publishedAt && (
          <span>
            <time datetime={publishedAt.toISOString()}>{dateCode(publishedAt)}</time>
          </span>
        )}
        <a href={url} target="_blank" rel="noreferrer">{source}</a>
        {(tags.length > 0 || problem.data.aiGenerated) && (
          <span>
            {[problem.data.aiGenerated ? "AI" : "", ...tags]
              .filter(Boolean)
              .join(" · ")}
          </span>
        )}
      </div>
    </header>
    <div class="markdown-content">
      <Content />
    </div>
  </article>
</Root>

<style>
  .problem-header {
    display: grid;
    gap: 0.8rem;
    padding-bottom: 2.25rem;
  }

  .problem-header .title {
    color: var(--default-text-color);
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.25;
    max-width: 76ch;
  }

  .meta {
    color: var(--default-muted-color);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    gap: 0.5rem 1rem;
  }
</style>
