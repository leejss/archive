---
import ProblemSourceLogo from "@/components/problem-source-logo.astro";
import Root from "@/layout/root.astro";
import { getPublishedProblems } from "@/lib/content";
import { formatDate } from "@/utils/common";

const problems = await getPublishedProblems();
---

<Root title="Problems">
  <main class="container">
    <ul class="post-list" aria-label="Problems">
      {problems.map((problem) => (
        <li class="post-item">
          <a href={`/problems/${problem.id}`} class="post-link">
            <ProblemSourceLogo source={problem.data.source} />
            {problem.data.title}
          </a>
          <time datetime={problem.data.publishedAt.toISOString()} class="post-date">
            {formatDate(problem.data.publishedAt)}
          </time>
        </li>
      ))}
    </ul>
  </main>
</Root>

<style>
  .post-date {
    color: var(--default-muted-color);
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-align: right;
    white-space: nowrap;
  }

  .post-list {
    display: grid;
    gap: 0.7rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-item {
    align-items: baseline;
    column-gap: 0.8rem;
    display: grid;
    font-size: 1rem;
    grid-template-columns: minmax(0, 1fr) max-content;
  }

  .post-link {
    color: var(--default-link-color);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .post-link:focus-visible {
    outline: 1px solid var(--default-border-hover-color);
    outline-offset: 0.2rem;
  }

</style>
