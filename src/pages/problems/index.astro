---
import { getCollection } from "astro:content";
import ProblemSourceLogo from "@/components/problem-source-logo.astro";
import Root from "@/layout/root.astro";

const problems = (await getCollection("problem")).sort(
  (a, b) =>
    new Date(b.data.publishedAt).getTime() -
    new Date(a.data.publishedAt).getTime(),
);

function dateCode(date: Date) {
  const yyyy = date.getFullYear();
  const mm = String(date.getMonth() + 1).padStart(2, "0");
  const dd = String(date.getDate()).padStart(2, "0");
  return `${yyyy}${mm}${dd}`;
}
---

<Root title="Problems">
  <main class="container">
    <ul class="post-list" aria-label="Problems">
      {problems.map((problem) => (
        <li class="post-item">
          <time datetime={problem.data.publishedAt.toISOString()} class="post-date">
            {`[${dateCode(problem.data.publishedAt)}]`}
          </time>
          <a href={`/problems/${problem.id}`} class="post-link">
            <ProblemSourceLogo source={problem.data.source} />
            {problem.data.title}
          </a>
        </li>
      ))}
    </ul>
  </main>
</Root>

<style>
  .post-date {
    color: var(--default-muted-color);
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    width: 9ch;
  }

  .post-list {
    display: grid;
    gap: 0.7rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-item {
    align-items: baseline;
    column-gap: 0.8rem;
    display: grid;
    font-size: 1rem;
    grid-template-columns: 9ch minmax(0, 1fr);
  }

  .post-link {
    color: var(--default-link-color);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .post-link:focus-visible {
    outline: 1px solid var(--default-border-hover-color);
    outline-offset: 0.2rem;
  }

</style>
