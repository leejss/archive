---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<aside class="table-of-contents">
  <details class="toc-mobile">
    <summary>목차</summary>
    <ol>
      {items.map((heading) => (
        <li data-depth={heading.depth}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </details>

  <nav class="toc-desktop" aria-labelledby="toc-title">
    <h2 id="toc-title">목차</h2>
    <ol>
      {items.map((heading) => (
        <li data-depth={heading.depth}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
</aside>

<style>
  .table-of-contents {
    color: var(--default-muted-color);
    font-size: 0.85rem;
    line-height: 1.45;
    min-width: 0;
  }

  .toc-mobile {
    border: 1px solid var(--default-border-color);
    padding: 0.8rem 1rem;
  }

  .toc-mobile summary {
    color: var(--default-text-color);
    cursor: pointer;
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .toc-mobile[open] summary {
    margin-bottom: 0.8rem;
  }

  .toc-desktop {
    display: none;
  }

  h2 {
    color: var(--default-text-color);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  ol {
    display: grid;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li[data-depth="3"] {
    padding-left: 0.8rem;
  }

  a {
    color: inherit;
    display: block;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  a:hover {
    color: var(--default-link-color);
  }

  a:focus-visible {
    outline: 1px solid var(--default-border-hover-color);
    outline-offset: 0.2rem;
  }

  @media (min-width: 72rem) {
    .table-of-contents {
      align-self: start;
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
      position: sticky;
      top: 1.5rem;
    }

    .toc-mobile {
      display: none;
    }

    .toc-desktop {
      display: block;
    }
  }
</style>
